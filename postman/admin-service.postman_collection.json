{
  "info": {
    "name": "admin-service",
    "description": "Аутентификация администратора и агрегированные маршруты (раздел 7.3 ТЗ). Сначала выполните POST /api/v1/auth/login, скопируйте JWT в переменную accessToken. Переменные: baseUrl, accessToken, productId, orderId.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3003" },
    { "key": "accessToken", "value": "" },
    { "key": "productId", "value": "" },
    { "key": "orderId", "value": "" }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "POST /api/v1/auth/login",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"login\": \"admin\",\n  \"password\": \"admin\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          }
        },
        {
          "name": "POST /api/v1/auth/logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        },
        {
          "name": "GET /api/v1/me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": "{{baseUrl}}/api/v1/me"
          }
        }
      ]
    },
    {
      "name": "Products (proxy to catalog)",
      "item": [
        {
          "name": "POST /api/v1/products",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"00000000-0000-0000-0000-000000000001\",\n  \"sku\": \"LED-A60-10W-4000K\",\n  \"name\": \"Светодиодная лампа A60 10Вт 4000K Е27\",\n  \"description\": \"Описание\",\n  \"price\": 189.00,\n  \"stock_qty\": 120,\n  \"image_url\": \"https://cdn.example.com/lamps/a60.jpg\",\n  \"is_published\": true\n}"
            },
            "url": "{{baseUrl}}/api/v1/products"
          }
        },
        {
          "name": "PUT /api/v1/products/:id",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"category_id\": \"00000000-0000-0000-0000-000000000001\",\n  \"sku\": \"LED-A60-10W-4000K\",\n  \"name\": \"Светодиодная лампа A60 10Вт 4000K Е27\",\n  \"description\": \"Описание\",\n  \"price\": 199.00,\n  \"stock_qty\": 100,\n  \"image_url\": \"https://cdn.example.com/lamps/a60.jpg\",\n  \"is_published\": true\n}"
            },
            "url": "{{baseUrl}}/api/v1/products/{{productId}}"
          }
        }
      ]
    },
    {
      "name": "Orders (proxy to order-service)",
      "item": [
        {
          "name": "GET /api/v1/orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/api/v1/orders?page=1&page_size=20&status=",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "orders"],
              "query": [
                { "key": "page", "value": "1" },
                { "key": "page_size", "value": "20" },
                { "key": "status", "value": "" }
              ]
            }
          }
        },
        {
          "name": "PATCH /api/v1/orders/:id/status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"confirmed\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/orders/{{orderId}}/status"
          }
        }
      ]
    }
  ]
}
